#!/usr/bin/env bash
# Stub `gh` CLI for the hermetic bats suites (§ Test Architecture › Stub executables).
# Env config:
#   STUB_GH_VERSION       semver in the `gh --version` banner          (default: 2.62.0)
#   STUB_GH_EXIT          exit code of a call no route decides          (default: 0)
#   STUB_GH_AUTH_EXIT     exit code of `gh auth status`                 (default: STUB_GH_EXIT)
#   STUB_GH_OUTPUT        stdout of a call no route decides             (default: none)
#   STUB_GH_ROUTES        file of `<argv glob>\t<exit>\t<stdout file>` lines; the
#                         argv joined by spaces is matched against each glob and
#                         the first match decides stdout and exit; a relative
#                         stdout file resolves against the routes file's directory,
#                         an empty field or `-` prints nothing; blank lines and
#                         `#` lines are skipped                          (default: off)
#   STUB_GH_STRICT        1 → any call that no route matches exits 9, built-ins
#                         included (route --version, `auth status` or `repo clone`
#                         under strict; a route with exit 0 on `repo clone` still
#                         performs the copy)                             (default: 0)
#   STUB_GH_CLONE_SOURCE  directory that `repo clone <src> [<dir>] [-- <gitflags>…]`
#                         copies into <dir> (default: basename of <src>) as a
#                         one-commit repository on `main` whose `origin` is <src>
#                         on github.com; <gitflags> are ignored          (default: off)
#   STUB_GH_LOG           append-log (default: off): one `gh <argv>` line per call;
#                         a call carrying `-F body=@-` then adds the stdin it read
# A route with exit 0 on `repo clone` still performs the copy; a non-zero route exit
# does not.
set -euo pipefail

log="${STUB_GH_LOG:-}"
if [[ -n "$log" ]]; then
  printf 'gh %s\n' "$*" >>"$log"
fi

# `-F body=@-` (also `--field body=@-`, `-Fbody=@-`, `--field=body=@-`) reads stdin.
reads_body=0
prev=""
for arg in "$@"; do
  case "$arg" in
    -Fbody=@- | --field=body=@-) reads_body=1 ;;
    body=@-)
      if [[ "$prev" == "-F" || "$prev" == "--field" ]]; then
        reads_body=1
      fi
      ;;
  esac
  prev="$arg"
done
if [[ "$reads_body" == 1 ]]; then
  body="$(cat)"
  if [[ -n "$log" ]]; then
    printf '%s\n' "$body" >>"$log"
  fi
fi

argv="$*"

clone_repo() {
  local src="${3:-}" dest="${4:-}" source="${STUB_GH_CLONE_SOURCE:-}" url
  if [[ -z "$src" ]]; then
    printf 'stub gh: repo clone needs a repository argument\n' >&2
    return 1
  fi
  if [[ -z "$dest" || "$dest" == "--" ]]; then
    dest="${src##*/}"
    dest="${dest%.git}"
  fi
  if [[ -z "$source" || ! -d "$source" ]]; then
    printf 'stub gh: STUB_GH_CLONE_SOURCE is not a directory: %s\n' "$source" >&2
    return 1
  fi
  if [[ -e "$dest" && -n "$(ls -A "$dest")" ]]; then
    printf "fatal: destination path '%s' already exists and is not an empty directory.\n" "$dest" >&2
    return 1
  fi
  case "$src" in
    *://* | git@*) url="$src" ;;
    *) url="https://github.com/${src%.git}.git" ;;
  esac
  printf "Cloning into '%s'...\n" "$dest" >&2
  mkdir -p "$dest"
  cp -R "$source/." "$dest/"
  rm -rf "$dest/.git"
  (
    export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
    export GIT_AUTHOR_NAME=acme GIT_AUTHOR_EMAIL=ci@example.invalid
    export GIT_COMMITTER_NAME=acme GIT_COMMITTER_EMAIL=ci@example.invalid
    export GIT_AUTHOR_DATE=2026-01-01T00:00:00Z GIT_COMMITTER_DATE=2026-01-01T00:00:00Z
    git -C "$dest" init -q -b main
    git -C "$dest" add -A
    git -C "$dest" -c commit.gpgsign=false commit -q --allow-empty -m 'Initial commit'
    git -C "$dest" remote add origin "$url"
  )
}

is_clone=0
if [[ "${1:-}" == "repo" && "${2:-}" == "clone" ]]; then
  is_clone=1
fi

routes="${STUB_GH_ROUTES:-}"
if [[ -n "$routes" ]]; then
  if [[ ! -f "$routes" ]]; then
    printf 'stub gh: STUB_GH_ROUTES file not found: %s\n' "$routes" >&2
    exit 2
  fi
  routes_dir="$(cd "$(dirname "$routes")" && pwd)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if [[ -z "$line" || "$line" == \#* ]]; then
      continue
    fi
    # Split on single tabs by hand: `read` with IFS=$'\t' would merge empty fields.
    glob="${line%%$'\t'*}"
    code=""
    out=""
    if [[ "$line" == *$'\t'* ]]; then
      rest="${line#*$'\t'}"
      code="${rest%%$'\t'*}"
      if [[ "$rest" == *$'\t'* ]]; then
        out="${rest#*$'\t'}"
      fi
    fi
    # shellcheck disable=SC2053 # the route field is a glob by contract
    if [[ "$argv" != $glob ]]; then
      continue
    fi
    code="${code:-0}"
    if [[ ! "$code" =~ ^[0-9]+$ ]]; then
      printf 'stub gh: route exit is not an integer: %s\n' "$code" >&2
      exit 2
    fi
    if [[ -n "$out" && "$out" != "-" ]]; then
      if [[ "$out" != /* ]]; then
        out="$routes_dir/$out"
      fi
      if [[ ! -f "$out" ]]; then
        printf 'stub gh: route stdout file not found: %s\n' "$out" >&2
        exit 2
      fi
      cat "$out"
    fi
    if [[ "$is_clone" == 1 && "$code" == 0 ]]; then
      clone_repo "$@"
    fi
    exit "$code"
  done <"$routes"
fi

if [[ "${STUB_GH_STRICT:-0}" == 1 ]]; then
  printf 'stub gh: no route for: gh %s\n' "$argv" >&2
  exit 9
fi

if [[ "${1:-}" == "--version" ]]; then
  printf 'gh version %s\n' "${STUB_GH_VERSION:-2.62.0}"
  exit "${STUB_GH_EXIT:-0}"
fi
if [[ "${1:-}" == "auth" && "${2:-}" == "status" ]]; then
  exit "${STUB_GH_AUTH_EXIT:-${STUB_GH_EXIT:-0}}"
fi
if [[ "$is_clone" == 1 ]]; then
  if [[ "${STUB_GH_EXIT:-0}" != 0 ]]; then
    exit "$STUB_GH_EXIT"
  fi
  clone_repo "$@"
  exit 0
fi
if [[ -n "${STUB_GH_OUTPUT:-}" ]]; then
  printf '%s\n' "$STUB_GH_OUTPUT"
fi
exit "${STUB_GH_EXIT:-0}"
