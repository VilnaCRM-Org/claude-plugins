#!/usr/bin/env bash
# Stub `curl` for the hermetic bats suites (§ Test Architecture › Stub executables).
# Env config:
#   STUB_CURL_EXIT    exit code of every call                              (default: 0)
#   STUB_CURL_OUTPUT  stdout of every call (verbatim, plus a newline); when unset a
#                     call that exits 0 prints a canned `HTTP/1.1 200` response in
#                     the `-i` form (CRLF header lines, then a JSON body) and a call
#                     with a non-zero exit prints a connection error on stderr
#   STUB_CURL_LOG     append-log of `curl <argv>` per call                 (default: off)
# A call that sends `@-` as data (`--data-binary @-`, `--data @-`, `-d @-`) reads its
# stdin to the end, as curl does, so a producer piping a body never dies of SIGPIPE.
set -euo pipefail

log="${STUB_CURL_LOG:-}"
if [[ -n "$log" ]]; then
  printf 'curl %s\n' "$*" >>"$log"
fi

reads_body=0
prev=""
for arg in "$@"; do
  case "$arg" in
    --data-binary=@- | --data=@- | -d@-) reads_body=1 ;;
    @-)
      case "$prev" in
        --data-binary | --data | -d) reads_body=1 ;;
      esac
      ;;
  esac
  prev="$arg"
done
if [[ "$reads_body" == 1 ]]; then
  cat >/dev/null
fi

code="${STUB_CURL_EXIT:-0}"
if [[ -n "${STUB_CURL_OUTPUT:-}" ]]; then
  printf '%s\n' "$STUB_CURL_OUTPUT"
elif [[ "$code" == 0 ]]; then
  printf 'HTTP/1.1 200 OK\r\n'
  printf 'content-type: application/json\r\n'
  printf 'content-length: 16\r\n'
  printf '\r\n'
  printf '{"status":"ok"}\n'
else
  printf "curl: (7) Failed to connect to 127.0.0.1 port 80 after 0 ms: Couldn't connect to server\n" >&2
fi
exit "$code"
