            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude/guard-protected-files.sh pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude/guard-protected-files.sh post"
